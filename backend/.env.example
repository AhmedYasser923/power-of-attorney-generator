# === Required ===
DATABASE=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-64-toString-hex
GEMINI_API_KEY=your-gemini-api-key

# === Optional (features degrade gracefully without these) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
EOC_EXCEL_URL=

# === Admin Bootstrap (first run only) ===
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# === CORS (comma-separated origins, omit for same-origin) ===
# CORS_ORIGINS=https://yourdomain.com

# === Optional model overrides (defaults in backend/config/models.js) ===
# GEMINI_MODEL_TICKET_STANDARD=gemini-3-flash-preview
# GEMINI_MODEL_TICKET_ADVANCED=gemini-3.5-flash
# GEMINI_MODEL_TEXT_AUTOFILL=gemini-3.1-flash-lite-preview
# GEMINI_MODEL_EMAIL=gemini-3.1-flash-lite
# GEMINI_MODEL_SIG_EASY=gemini-2.5-flash-image
# GEMINI_MODEL_SIG_MEDIUM=gemini-3.1-flash-image-preview
# GEMINI_MODEL_SIG_HARD=gemini-3-pro-image-preview

# === Platform-set (do not configure manually) ===
# PORT=3000
# NODE_ENV=production
# K_REVISION=set-by-cloud-run
