# === Required ===
DATABASE=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-64-toString-hex
GEMINI_API_KEY=your-gemini-api-key

# === Optional (features degrade gracefully without these) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
EOC_EXCEL_URL=

# === Admin Bootstrap (first run only) ===
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# === CORS (comma-separated origins, omit for same-origin) ===
# CORS_ORIGINS=https://yourdomain.com

# === Platform-set (do not configure manually) ===
# PORT=3000
# NODE_ENV=production
# K_REVISION=set-by-cloud-run
