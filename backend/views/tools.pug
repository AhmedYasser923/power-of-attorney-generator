extends layout

block head
  link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap")

block content
  style.
    @keyframes pulsyGlassyRed {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5), inset 0 0 10px rgba(220, 38, 38, 0.1);
            background-color: rgba(254, 242, 242, 0.4);
            border-color: rgba(239, 68, 68, 0.5);
        }
        100% {
            box-shadow: 0 0 20px 8px rgba(220, 38, 38, 0), inset 0 0 30px rgba(220, 38, 38, 0.2);
            background-color: rgba(254, 242, 242, 0.85);
            border-color: rgba(220, 38, 38, 1);
        }
    }
    .eoc-alert-active {
        animation: pulsyGlassyRed 1.5s infinite alternate ease-in-out !important;
        border-width: 2px !important;
        backdrop-filter: blur(8px) !important;
        transition: all 0.3s ease;
    }

    /* Bento grid layout (used by announcements panel) */
    .ts-toolkit-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
    }
    .ts-grid-full {
        grid-column: 1 / -1;
    }

    /* Collapsible tool card title */
    .tk-title {
        color: #1e293b;
        margin: 0 0 20px 0;
        font-size: 18px;
        font-weight: 700;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
        .ts-toolkit-grid {
            grid-template-columns: 1fr;
        }
    }

  //- Inject server-side jurisdiction data for the frontend JS to consume
  script.
    window.JURISDICTION_LIMITS = !{JSON.stringify(jurisdictionLimits)};
    window.EMAIL_TEMPLATES = !{emailTemplatesJson};

  //- ── PANEL: TICKET ANALYZER ────────────────────────────────────────────────
  .tool-panel#panel-ticket-analyzer
    .ta-layout
      h1.ta-header__title 🎫 Ticket Analyzer
      p.ta-header__subtitle Drop multiple e-tickets, boarding passes, or flight screenshots below. Our vision model will instantly extract structured passenger data and evaluate EC261 / UK261 claim eligibility.
      .ta-dropzone#ticketDropZone(tabindex="0")
        span.ta-dropzone__icon 📥
        h2.ta-dropzone__title Click, Drag & Drop, or Paste (Ctrl+V)
        p.ta-dropzone__text Supports multiple PDFs, PNGs, and JPGs at once
        input.ta-dropzone__input#ticketInput(type="file", accept="image/*,application/pdf", multiple)
      .ta-preview#previewTicketContainer
        .ta-preview__header
          p.ta-preview__name#ticketNameDisplay
          button.ta-preview__clear-btn#clearFilesBtn(type="button" title="Clear all files") ✖
        button.ta-preview__analyze-btn#analyzeBtn ✨ Extract Ticket Data
      .ta-results#resultsCard

  //- ── PANEL: POA GENERATOR ──────────────────────────────────────────────────
  .tool-panel#panel-poa
    #loader-overlay.poa-loader
      .modern-spinner
      p.poa-loader__text Generating PDF... Please wait
    .poa-container
      .tool-header
        h1.tool-header__title POA Generator
        p.tool-header__subtitle Generate Power of Attorney documents with AI autofill and signature processing.
      .poa-form-group
        label.poa-label(for="templateSelector") Select Template Format
        select#templateSelector.poa-select
          option(value="standard") Standard ReFly Template (1 Passenger)
          option(value="lufthansa") Lufthansa Template (Up to 4 Passengers)
          option(value="aerlingus") Aer Lingus Template (1 Passenger)
      .poa-ai-zone#aiZoneContainer
        label.poa-ai-zone__label ✨ AI Autofill & Signature Drop
        p.poa-ai-zone__desc Use <b>Ditto</b> to paste text and signatures globally. Text goes to AI, images auto-attach to the active form below.
        textarea#aiAutofillInput.poa-textarea(rows="3" placeholder="Paste text here...")
        button#aiAutofillBtn.poa-btn.poa-btn--success(type="button") Extract & Fill Form
      form#standardForm.poa-form(action="/generate-standard", method="POST", enctype="multipart/form-data", autocomplete="off")
        h3.poa-form-title Standard Form Details
        .poa-form-group
          label.poa-label Document Language
          select.poa-select(name="lang")
            option(value="En" selected) English (En)
            option(value="Fr") French (Fr)
            option(value="De") German (De)
            option(value="Es") Spanish (Es)
            option(value="It") Italian (It)
            option(value="Pt") Portuguese (Pt)
            option(value="Tr") Turkish (Tr)
            option(value="Ar") Arabic (Ar)
            option(value="Pl") Polish (Pl)
            option(value="Sv") Swedish (Sv)
            option(value="No") Norwegian (No)
            option(value="Da") Danish (Da)
            option(value="Fi") Finnish (Fi)
            option(value="Nl") Dutch (Nl)
            option(value="Ro") Romanian (Ro)
            option(value="Hi") Hindi (Hi)
            option(value="Ja") Japanese (Ja)
            option(value="He") Hebrew (He)
            option(value="CH") chienese (Ch)
            option(value="Al") albanian (Al)
            option(value="Gr") greek (Gr)
        .poa-row
          .poa-col
            label.poa-label First Name *
            input.poa-input(type="text", name="firstName", placeholder="First name", required)
          .poa-col
            label.poa-label Last Name *
            input.poa-input(type="text", name="lastName", placeholder="Last name", required)
        .poa-form-group
          label.poa-label Address *
          textarea.poa-textarea(name="address", rows="3", placeholder="Full address", required)
        .poa-form-group
          label.poa-label PNR Number *
          input.poa-input(type="text", name="pnr", placeholder="e.g. TGFX69", required, minlength="5", pattern="[A-Za-z0-9]{5,}")
        .poa-form-group
          label.poa-label Date *
          input.poa-input(type="date", name="date", required)
        .poa-form-group
          label.poa-label Signature Image (optional)
          .drop-zone.poa-dropzone
            p.drop-zone-text.poa-dropzone__text Click to Upload, Drag & Drop, or Paste (Ctrl+V)
            input.sig-file-input(type="file", name="signature", accept="image/*", style="display: none;")
            img.sig-preview(src="", style="max-height: 80px; display: none; margin: 10px auto;")
        .poa-sig-processing-box
          label.poa-label Signature Processing Option
          select.poa-select(name="sigProcessing")
            option(value="none", selected) None (Use Raw Image)
            option(value="cloudinary") Cloudinary AI (Background Removal)
            option(value="gemini-easy") Nano Banana — Easy
            option(value="gemini-medium") Nano Banana — Medium
            option(value="gemini-hard") Nano Banana — Hard
        button.poa-btn.poa-btn--primary.poa-mt-20(type="submit") Generate Standard PDF
      form#lufthansaForm.poa-form(action="/generate-lufthansa", method="POST", enctype="multipart/form-data", style="display: none;", autocomplete="off")
        h3.poa-form-title Lufthansa Form Details
        .poa-row
          .poa-col
            label.poa-label Flight Number
            input.poa-input(type="text", name="flightNumber")
          .poa-col
            label.poa-label PNR / Booking Code *
            input.poa-input(type="text", name="pnr", required, minlength="5", maxlength="9", pattern="[A-Za-z0-9]{5,9}")
          .poa-col
            label.poa-label Flight Date *
            input.poa-input(type="date", name="flightDate", required)
        .poa-row.poa-row--align-start.poa-mt-20
          .poa-col.poa-col--1-2
            h4 Passenger Details
            #names-container.poa-panel
              - for (var i = 1; i <= 4; i++)
                .poa-row.poa-row--no-margin.poa-row--center
                  .poa-col.poa-col--no-margin
                    label.poa-label Passenger #{i} Full Name #{i === 1 ? '*' : '(Optional)'}
                    input.poa-input(type="text", name=`fullName${i}`, placeholder="e.g. Pamela Nelson", required=(i === 1))
                if i === 1
                  .poa-row.poa-row--no-margin.poa-mt-10
                    .poa-col.poa-col--no-margin
                      label.poa-label Main Claimer Address *
                      textarea.poa-textarea(name="address1", rows="2", required=true)
          .poa-col.poa-col--1
            h4 Signatures
            #signatures-container.poa-panel
              .poa-form-group.poa-form-group--no-margin
                label.poa-label Claim Submission Date *
                input.poa-input(type="date", name="claimDate", required)
              .drop-zone.poa-dropzone#lufthansa-drop-zone
                p.drop-zone-text.poa-dropzone__text Click to Upload, Drag & Drop, or Paste (Ctrl+V)
                input#lufthansa-sig-input(type="file", name="signatures", accept="image/*", multiple=true, style="display: none;")
              #lufthansa-sig-previews.poa-sig-previews
                span#preview-placeholder.poa-preview-placeholder Previews appear here...
              div
                label.poa-label.poa-label--bold Processing Method per Signature:
                .poa-sig-processing-list
                  - for (var i = 1; i <= 4; i++)
                    .poa-sig-processing-item
                      label.poa-sig-processing-item__label Sig #{i}:
                      select.poa-select.poa-select--small(name=`sigProcessing${i}`)
                        option(value="none", selected) None (Raw)
                        option(value="cloudinary") Cloudinary AI
                        option(value="gemini-easy") Easy
                        option(value="gemini-medium") Medium
                        option(value="gemini-hard") Hard
        button.poa-btn.poa-btn--primary.poa-btn--full.poa-mt-25(type="submit") Generate Lufthansa PDF
      form#aerLingusForm.poa-form(action="/generate-aerlingus", method="POST", enctype="multipart/form-data", style="display: none;", autocomplete="off")
        h3.poa-form-title Aer Lingus Form Details
        .poa-row
          .poa-col
            label.poa-label Type of Claim *
            select.poa-select(name="claimType" required)
              option(value="compensation") Compensation Claim (Regulation EC 261/2004)
              option(value="expense") Expense Claim
              option(value="baggage") Delayed, Lost or Damaged Baggage Claim
              option(value="complaint") Complaint
              option(value="other") Other
          .poa-col
            label.poa-label Case Number (Optional)
            input.poa-input(type="text", name="caseNumber")
        .poa-row
          .poa-col
            label.poa-label Passenger First Name *
            input.poa-input(type="text", name="firstName", required)
          .poa-col
            label.poa-label Passenger Last Name *
            input.poa-input(type="text", name="lastName", required)
        .poa-form-group
          label.poa-label Passenger Address *
          textarea.poa-textarea(name="address", rows="2", required)
        .poa-row
          .poa-col
            label.poa-label PNR / Booking Code *
            input.poa-input(type="text", name="pnr", required, minlength="5", maxlength="9", pattern="[A-Za-z0-9]{5,9}")
          .poa-col
            label.poa-label Flight Number
            input.poa-input(type="text", name="flightNumber")
          .poa-col
            label.poa-label Flight Date *
            input.poa-input(type="date", name="flightDate", required)
        .poa-form-group
          label.poa-label Route (Specify to and from)
          input.poa-input(type="text", name="route", placeholder="e.g. DUB - JFK")
        .poa-form-group
          label.poa-label Signature Image *
          .drop-zone.poa-dropzone
            p.drop-zone-text.poa-dropzone__text Click to Upload, Drag & Drop, or Paste (Ctrl+V)
            input.sig-file-input(type="file", name="signature", accept="image/*", style="display: none;", required)
            img.sig-preview(src="", style="max-height: 80px; display: none; margin: 10px auto;")
        .poa-sig-processing-box
          label.poa-label Signature Processing Option
          select.poa-select(name="sigProcessing")
            option(value="none", selected) None (Use Raw Image)
            option(value="cloudinary") Cloudinary AI (Background Removal)
            option(value="gemini-easy") Nano Banana — Easy
            option(value="gemini-medium") Nano Banana — Medium
            option(value="gemini-hard") Nano Banana — Hard
        button.poa-btn.poa-btn--aerlingus.poa-btn--full.poa-mt-25(type="submit") Generate Aer Lingus PDF

  //- ── PANEL: FLIGHTSTATS (CIRIUM) ───────────────────────────────────────────
  .tool-panel#panel-flight-stats
    .ts-card
      h2.tk-title 📡 FlightStats (Cirium)
      .ts-form-row
        .ts-form-group(style="flex: 1;")
          label.ts-label Flight Number
          input#c-flight.ts-input(type="text" placeholder="e.g. U28412" required)
        .ts-form-group(style="flex: 1;")
          label.ts-label Departure Date
          input#c-date.ts-input(type="date" required)
        button#btn-fetch-cirium.ts-btn-fetch(type="button") Search Flight
      #flightResult.ts-results-row
  //- ── PANEL: EXTERNAL FLIGHT TRACKERS ───────────────────────────────────────
  .tool-panel#panel-flight-search
    .flight-search-tool
      .flight-search-tool__header
        h1.flight-search-tool__title Flight Search
        p.flight-search-tool__subtitle Look up real-time flight data and passenger information
      .flight-search-tool__grid
        .flight-search-tool__field
          label.flight-search-tool__label(for="fs-flight") Flight Number
          input#fs-flight.flight-search-tool__input.flight-search-tool__input--mono(type="text" placeholder="e.g. BA0123")
        .flight-search-tool__field
          label.flight-search-tool__label(for="fs-date") Travel Date
          input#fs-date.flight-search-tool__input(type="date")
      .flight-search-tool__options
        label.flight-search-tool__option
          input#fs-chk-ai(type="checkbox" checked)
          | AirportInfo
        label.flight-search-tool__option
          input#fs-chk-fs(type="checkbox" checked)
          | FlightStats
        label.flight-search-tool__option
          input#fs-chk-ft(type="checkbox" checked)
          | Flightera
      button#btn-flight-search.flight-search-tool__button(type="button" disabled) Search Flights

  //- ── PANEL: ROC RADAR ──────────────────────────────────────────────────────
  .tool-panel#panel-eoc
    .eoc-tool
      .eoc-tool__header
        h1.eoc-tool__title ROC Radar
        p.eoc-tool__subtitle Scan extraordinary circumstance records by flight date and route
      .eoc-tool__grid
        .eoc-tool__field
          label.eoc-tool__label(for="e-date") Flight Date
          .eoc-tool__date-control
            input#e-date.eoc-tool__input(type="text" placeholder="Select or paste a date..." required)
            input#e-date-picker.eoc-tool__date-picker(type="date" required)
            label.eoc-tool__date-trigger(for="e-date-picker") 📅
        .eoc-tool__field
          label.eoc-tool__label(for="e-o-iata") Origin Airport
          input#e-o-iata.eoc-tool__input.eoc-tool__input--mono(type="text" placeholder="e.g. LHR or Heathrow")
        .eoc-tool__field
          label.eoc-tool__label(for="e-d-iata") Destination Airport
          input#e-d-iata.eoc-tool__input.eoc-tool__input--mono(type="text" placeholder="e.g. BER or Berlin")
        .eoc-tool__field
          label.eoc-tool__label(for="e-o-country") Origin Country
          input#e-o-country.eoc-tool__input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
        .eoc-tool__field
          label.eoc-tool__label(for="e-d-country") Destination Country
          input#e-d-country.eoc-tool__input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
      .eoc-tool__actions
        button#btn-eoc.eoc-tool__button.eoc-tool__button--primary(type="button") Scan EOC Database
        button#btn-sync-eoc.eoc-tool__button.eoc-tool__button--secondary(type="button") Sync EOC Database
      #syncEocResult
      #eocResult

  //- ── PANEL: DOCUMENT CHECK ─────────────────────────────────────────────────
  .tool-panel#panel-doc-check
    .ops-tool
      .ops-tool__header
        h1.ops-tool__title Document Check
        p.ops-tool__subtitle Verify required claim documents by airline
      .ops-tool__action-row
        .ops-tool__field.ops-tool__field--grow
          label.ops-tool__label(for="d-airline") Airline
          input#d-airline.ops-tool__input(type="text" placeholder="Start typing an airline name..." autocomplete="off")
      #docsResult.ops-tool__results

  //- ── PANEL: JURISDICTION ───────────────────────────────────────────────────
  .tool-panel#panel-jurisdiction
    .ops-tool
      .ops-tool__header
        h1.ops-tool__title Jurisdiction Checker
        p.ops-tool__subtitle Identify applicable compensation limitation periods by country
      .ops-tool__action-row
        .ops-tool__field.ops-tool__field--grow
          label.ops-tool__label(for="j-country") Country
          input#j-country.ops-tool__input(type="text" placeholder="Start typing a country... e.g. Germany" autocomplete="off")
      #jurisdictionResult.ops-tool__results

  //- ── PANEL: IATA LOOKUP ────────────────────────────────────────────────────
  .tool-panel#panel-iata
    .ops-tool
      .ops-tool__header
        h1.ops-tool__title IATA Lookup
        p.ops-tool__subtitle Resolve airline codes and carrier details instantly
      .ops-tool__action-row
        .ops-tool__field.ops-tool__field--grow
          label.ops-tool__label(for="iata-lookup-input") Airline Name or IATA Code
          input#iata-lookup-input.ops-tool__input.ops-tool__input--mono(type="text" placeholder="e.g. AA or American Airlines" autocomplete="off")
        button#btn-iata-lookup.ops-tool__button.ops-tool__button--primary(type="button") Search
      #iata-lookup-result.ops-tool__results

  //- ── PANEL: EMAIL BUILDER ──────────────────────────────────────────────────
  .tool-panel#panel-email
    .ts-card
      .tool-header
        h1.tool-header__title Multilingual Email Builder
        p.tool-header__subtitle Generate passenger correspondence in multiple languages
      form#emailBuilderForm
        .split-layout.email-builder
          .split-left
            .split-left-header
              .split-left-header__row
                div
                  h3 Select Content
                  p Choose what to include in the email
                button#emManageBtn(type="button" title="Manage Templates") Manage
            .split-groups
              #emPillGroups
              #emSidebarRequest.email-advanced
                .split-group
                  .split-group-label Advanced
                  .email-field
                    label.split-footer-lbl(for="emLink") Upload Link
                    input#emLink.input.ts-input(type="text" placeholder="https://...")
                    p.email-field__hint For Passenger Docs, Signed POA, and Fill Dashboard.
            .split-footer
              .email-footer-options
                label.email-toggle.em-freestyle-toggle
                  input#emUseNote(type="checkbox")
                  span.email-toggle__label Custom Request
                #emNoteArea(style="display: none;")
                  textarea#emCustomNote.textarea.ts-input(placeholder="Additional message to include...")
                #emWrapperRow
                  label.email-toggle.em-freestyle-toggle
                    input#emUseWrapper(type="checkbox")
                    span.email-toggle__label Add sign-off
              .split-footer-row.email-lang.em-language-group
                label.split-footer-lbl(for="emLanguage") Language
                select#emLanguage.split-lang
                  option(value="English") English
                  option(value="Spanish") Spanish
                  option(value="French") French
                  option(value="German") German
                  option(value="Italian") Italian
                  option(value="Dutch") Dutch
                  option(value="Swedish") Swedish
                  option(value="Polish") Polish
                  option(value="Portuguese") Portuguese
                  option(value="Danish") Danish
                  option(value="Norwegian") Norwegian
                  option(value="Finnish") Finnish
                  option(value="Romanian") Romanian
                  option(value="Czech") Czech
                  option(value="Hungarian") Hungarian
                  option(value="Greek") Greek
                  option(value="Turkish") Turkish
                  option(value="Arabic") Arabic
              button#emGenerateBtn.split-gen(type="submit")
                span.split-gen-icon *
                | Generate Email
          .split-right
            .split-right-header
              h3 Preview
              .tab-row
                button.stab.active(type="button" data-preview-tab="output") English
                button.stab(type="button" data-preview-tab="verify") EN verify
            .split-preview
              #emPlaceholder.email-placeholder
                p Select content, then click Generate Email
              #emPlaceholderSection(style="display:none")
              #emResultBox.email-mock(style="display: none;")
                .email-body-text#emOutputText
              #emEnglishBox.en-verify-box(style="display: none;")
                .en-verify-header
                  span.en-verify-label English Verification
                .en-verify-body#emEnglishText
            .split-actions
              button#emCopyBtn.act-primary(type="button") Copy Email
              button#emRegenBtn.act-secondary(type="button") Regenerate
              button#emCopyEnglishBtn.act-secondary(type="button") Copy English
              span#emCharCount.act-meta -

  //- ── PANEL: EC261 CALCULATOR ───────────────────────────────────────────────
  .tool-panel#panel-ec261
    .ops-tool
      .ops-tool__header
        h1.ops-tool__title EC261 Compensation Calculator
        p.ops-tool__subtitle Calculate statutory passenger compensation under EU Regulation 261/2004
      .ops-tool__grid
        .ops-tool__field
          label.ops-tool__label(for="l-origin") Departure Airport
          input#l-origin.ops-tool__input.ops-tool__input--mono(type="text" placeholder="e.g. LHR or Heathrow" required)
        .ops-tool__field
          label.ops-tool__label(for="l-origin-country") Origin Country
          input#l-origin-country.ops-tool__input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
        .ops-tool__field
          label.ops-tool__label(for="l-dest") Arrival Airport
          input#l-dest.ops-tool__input.ops-tool__input--mono(type="text" placeholder="e.g. JFK or Kennedy" required)
        .ops-tool__field
          label.ops-tool__label(for="l-dest-country") Destination Country
          input#l-dest-country.ops-tool__input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
      .ops-tool__actions
        button#btn-ec261.ops-tool__button.ops-tool__button--primary(type="button") Calculate Compensation
      #ec261Result.ops-tool__results

  //- ── PANEL: ANNOUNCEMENTS ──────────────────────────────────────────────────
  .tool-panel#panel-announcements
    .ann-page-header
      h1 Announcements
      p Log operational updates and search previous announcements
    .ann-layout
      aside.ann-sub-sidebar
        .ann-sub-header
          h1 Announcements
        nav.ann-nav
          span.ann-nav-sec Feed
          #ann-subject-chips.ann-filter-row
          span.ann-nav-sec Tools
          button.ann-nav-item.ann-tool-toggle(type="button" data-ann-panel="saved") Archive
          button.ann-nav-item.ann-tool-toggle(type="button" data-ann-panel="interactions") Interactions
        button.ann-post-btn(type="button" data-ann-panel="post") + Post Announcement

      section.ann-main
        .ann-toolbar
          .ann-ask-inline
            span.ann-btn-icon *
            input#ann-question(type="text" placeholder="Ask AI about announcements...")
          button#ann-ask-btn.ann-ai-btn(type="button")
            span.ann-btn-icon *
            | Ask AI
          button.ann-post-main-btn(type="button" data-ann-panel="post") + New Post
          button.ann-saved-btn(type="button" data-ann-panel="saved") Saved

        .ann-panel-stack#ann-panel-stack
          .ann-drawer#ann-post-panel
            .ann-drawer-header
              h2 New Announcement
              button.ann-panel-close(type="button" data-ann-panel-close aria-label="Close") x
            .ann-form-row
              .ann-field
                label(for="ann-announcer") Announcer Name
                input#ann-announcer.ann-input(type="text" placeholder="e.g. Ahmed")
              .ann-field
                label(for="ann-date") Date
                input#ann-date.ann-input(type="date")
            .ann-field
              label(for="ann-content") Announcement
              textarea#ann-content.ann-textarea(placeholder="Paste or type the announcement here...")
            .ann-field
              label(for="ann-images") Images (optional)
              input#ann-images.ann-file-input.ann-file-input--hidden(type="file" accept="image/*" multiple)
              .ann-upload-review(data-upload-zone data-input-id="ann-images" data-multiple="true" tabindex="0")
                .ann-upload-copy
                  .ann-upload-title Drag, paste, or choose screenshots
                  .ann-upload-subtitle Images appear here for review before posting.
                button.ann-upload-browse(type="button" data-upload-browse) Choose
                .ann-upload-list(data-upload-list)
            .ann-actions
              button#ann-submit-btn.ann-submit-btn(type="button") Add Announcement
          .ann-drawer#ann-saved-panel
            .ann-drawer-header
              h2 Saved Answers
              button.ann-panel-close(type="button" data-ann-panel-close aria-label="Close") x
            #ann-saved-list.ann-saved-list
