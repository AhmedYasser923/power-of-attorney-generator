extends layout

block content
  .auth-page
    .auth-card
      a(href="/")
        img.auth-card__logo(src="/images/Screenshot_1.png", alt="Refly Logo")
      h1.auth-card__title Sign In
      p.auth-card__subtitle Enter your credentials to access the workspace

      if error
        .auth-alert.auth-alert--error
          span= error

      form.auth-form(action="/login" method="POST")
        .auth-form__group
          label.auth-form__label(for="email") Email Address
          input.auth-form__input(
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
          )
        .auth-form__group
          label.auth-form__label(for="password") Password
          input.auth-form__input(
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            required
            autocomplete="current-password"
          )
        button.auth-btn(type="submit") Sign In

      p.auth-card__footer
        | Don't have an account?&nbsp;
        a.auth-card__link(href="/signup") Request Access
