extends layout

block content
  link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap")
  style.
    @keyframes pulsyGlassyRed {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5), inset 0 0 10px rgba(220, 38, 38, 0.1);
            background-color: rgba(254, 242, 242, 0.4);
            border-color: rgba(239, 68, 68, 0.5);
        }
        100% {
            box-shadow: 0 0 20px 8px rgba(220, 38, 38, 0), inset 0 0 30px rgba(220, 38, 38, 0.2);
            background-color: rgba(254, 242, 242, 0.85);
            border-color: rgba(220, 38, 38, 1);
        }
    }
    .eoc-alert-active {
        animation: pulsyGlassyRed 1.5s infinite alternate ease-in-out !important;
        border-width: 2px !important;
        backdrop-filter: blur(8px) !important;
        transition: all 0.3s ease;
    }

    /* Make tabs horizontally scrollable */
    .ts-tabs {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 12px;
        -webkit-overflow-scrolling: touch; 
        scrollbar-width: none;
    }
    .ts-tabs::-webkit-scrollbar {
        display: none;
    }
    .ts-tab-btn {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    /* Tab content visibility */
    .ts-tab-content {
        display: none !important;
    }
    .ts-tab-content.active {
        display: block !important;
    }

    /* THE NEW BENTO BOX GRID */
    .ts-toolkit-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
    }
    .ts-card {
        margin-bottom: 0 !important;
        height: 100%;
    }
    .ts-grid-full {
        grid-column: 1 / -1;
    }

    /* Collapsible toolkit cards */
    .tk-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
    }
    .tk-title {
        color: #1e293b;
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }
    .tk-chevron {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 11px;
        flex-shrink: 0;
        transition: transform 0.25s ease, background 0.15s;
    }
    .tk-header:hover .tk-chevron {
        background: #e2e8f0;
    }
    .ts-card.tk-collapsed .tk-chevron {
        transform: rotate(-90deg);
    }
    .ts-card.tk-collapsed > *:not(.tk-header) {
        display: none;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
        .ts-toolkit-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Email Builder */
    .em-builder-layout {
        display: grid;
        grid-template-columns: 1fr 250px;
        gap: 20px;
        align-items: start;
    }
    .em-sidebar {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .em-section {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 10px;
    }
    .em-section-title {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 8px 0;
    }
    .em-checklist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
        transition: opacity 0.2s ease;
    }
    .em-checklist-item {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        padding: 5px 8px;
        border-radius: 6px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
        font-size: 12.5px;
        color: #334155;
        line-height: 1.3;
        user-select: none;
    }
    .em-checklist-item:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
    }
    .em-checklist-item input[type="checkbox"] {
        margin-top: 2px;
        flex-shrink: 0;
        accent-color: #6366f1;
        width: 13px;
        height: 13px;
        cursor: pointer;
    }
    .em-rejection-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 8px 0 6px;
    }
    .em-rejection-divider span {
        font-size: 11px;
        font-weight: 800;
        color: #991b1b;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .em-rejection-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #fecaca;
    }
    .em-checklist-item.rejection {
        color: #7f1d1d;
    }
    .em-checklist-item.rejection:hover {
        background: #fef2f2;
        border-color: #fecaca;
    }
    .em-checklist-item.rejection input[type="checkbox"] {
        accent-color: #dc2626;
    }
    .em-custom-area {
        margin-top: 12px;
    }
    .em-freestyle-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        padding: 7px 10px;
        border-radius: 7px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }
    .em-freestyle-toggle:has(input:checked) {
        background: #eff6ff;
        border-color: #bfdbfe;
    }
    .em-freestyle-toggle input[type="checkbox"] {
        accent-color: #3b82f6;
        width: 15px;
        height: 15px;
        cursor: pointer;
        flex-shrink: 0;
    }
    .em-freestyle-toggle label {
        font-size: 13px;
        color: #475569;
        cursor: pointer;
        line-height: 1.3;
    }
    .em-freestyle-toggle:has(input:checked) label {
        color: #1d4ed8;
        font-weight: 600;
    }
    .em-bottom-row {
        display: flex;
        gap: 12px;
        align-items: stretch;
    }
    .em-language-group {
        flex: 1;
    }
    .em-language-group label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .em-generate-btn {
        flex-shrink: 0;
        align-self: flex-end;
        background: #6366f1;
        color: #fff;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
        white-space: nowrap;
    }
    .em-generate-btn:hover:not(:disabled) {
        background: #4f46e5;
    }
    .em-generate-btn:active:not(:disabled) {
        transform: scale(0.98);
    }
    .em-generate-btn:disabled {
        background: #a5b4fc;
        cursor: not-allowed;
    }
    .em-result-box {
        margin-top: 20px;
        border-top: 1px solid #e2e8f0;
        padding-top: 20px;
    }
    .em-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .em-result-label {
        font-size: 13px;
        font-weight: 700;
        color: #10b981;
    }
    .em-copy-btn {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        font-weight: 600;
        color: #334155;
        transition: background 0.15s;
    }
    .em-copy-btn:hover {
        background: #e2e8f0;
    }
    .em-output-textarea {
        width: 100%;
        height: 260px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-family: monospace;
        font-size: 13px;
        line-height: 1.6;
        resize: vertical;
        background: #fff;
        color: #1e293b;
        box-sizing: border-box;
        outline: none;
    }
    .em-char-count {
        margin-top: 5px;
        font-size: 11.5px;
        color: #94a3b8;
        text-align: right;
    }
    .em-english-box {
        margin-top: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
    }
    .em-english-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 14px;
        background: #f8fafc;
        border-bottom: 1px dashed #cbd5e1;
    }
    .em-english-label {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .em-english-content {
        padding: 14px;
        font-family: monospace;
        font-size: 12.5px;
        line-height: 1.6;
        background: #f8fafc;
        color: #475569;
        white-space: pre-wrap;
    }
    /* Email Builder Inner Tabs */
    .em-inner-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 20px;
    }
    .em-inner-tab-btn {
        padding: 8px 18px;
        border: none;
        background: none;
        font-size: 13px;
        font-weight: 600;
        color: #94a3b8;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: color 0.15s, border-color 0.15s;
        white-space: nowrap;
    }
    .em-inner-tab-btn:hover { color: #475569; }
    .em-inner-tab-btn.active {
        color: #6366f1;
        border-bottom-color: #6366f1;
    }
    .em-inner-tab-content { display: none; }
    .em-inner-tab-content.active { display: block; }
    /* Tone selector */
    .em-tone-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
    }
    .em-tone-pill {
        display: flex;
        align-items: center;
        padding: 7px 16px;
        border: 1.5px solid #e2e8f0;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        transition: all 0.15s;
        user-select: none;
    }
    .em-tone-pill input[type="radio"] { display: none; }
    .em-tone-pill:has(input:checked) {
        background: #eff6ff;
        border-color: #6366f1;
        color: #4338ca;
    }
    .em-tone-pill:hover { border-color: #a5b4fc; }
    @media (max-width: 900px) {
        /* Stack builder layout */
        .em-builder-layout { grid-template-columns: 1fr; }
        /* Tighter section padding */
        .em-section { padding: 10px; margin-bottom: 8px; }
        .em-section-title { margin-bottom: 6px; }
        .em-checklist-item { padding: 4px 7px; font-size: 12px; }
        .em-checklist { gap: 4px; }
        /* Sidebar becomes a compact row below the checklist */
        .em-sidebar { flex-direction: row; flex-wrap: wrap; gap: 8px; }
        #emSidebarRequest { flex: 1 1 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-items: start; }
        #emSidebarRequest .em-section { margin-bottom: 0; }
        #emSidebarRequest > label.em-freestyle-toggle { grid-column: 1 / -1; margin-top: 0; }
        #emSidebarDraft { flex: 1 1 100%; }
        .em-sidebar > .em-language-group { flex: 1 1 auto; margin-top: 0 !important; }
        .em-sidebar > button { flex: 0 0 auto; margin-top: 0 !important; width: auto; align-self: flex-end; }
        /* Shorter result textarea */
        .em-output-textarea { height: 180px; }
        .em-bottom-row { flex-direction: column; }
    }

    /* Announcements Tab */
    #announcements {
        font-family: 'Nunito', sans-serif;
    }
    .ann-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }
    @media (max-width: 768px) {
        .ann-form-row { grid-template-columns: 1fr; }
    }
    .ann-textarea {
        width: 100%;
        min-height: 90px;
        resize: vertical;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        font-family: inherit;
        color: #1e293b;
        background: #fff;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s;
    }
    .ann-textarea:focus { border-color: #6366f1; }
    .ann-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 20px;
        padding: 12px 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }
    .ann-chip {
        padding: 6px 16px;
        border-radius: 20px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        font-size: 13px;
        font-weight: 700;
        font-family: 'Nunito', sans-serif;
        cursor: pointer;
        color: #475569;
        letter-spacing: 0.01em;
        line-height: 1;
        transition: background 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .ann-chip:hover {
        border-color: #a5b4fc;
        color: #4f46e5;
        background: #eef2ff;
    }
    .ann-chip.active {
        background: #6366f1;
        border-color: #6366f1;
        color: #fff;
        box-shadow: 0 2px 6px rgba(99,102,241,0.3);
    }
    .ann-date-group { margin-bottom: 20px; }
    .ann-date-header {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f1f5f9;
    }
    .ann-card {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .ann-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ann-channel-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .ann-announcer {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
    }
    .ann-date-pill {
        font-size: 11.5px;
        color: #94a3b8;
        margin-left: auto;
    }
    .ann-content {
        font-size: 13.5px;
        color: #334155;
        line-height: 1.8;
        word-break: break-word;
    }
    .ann-content br {
        display: block;
        margin-top: 8px;
        content: "";
    }
    .ann-content ul {
        margin: 8px 0 4px 20px;
        padding: 0;
    }
    .ann-content li {
        margin-bottom: 7px;
        line-height: 1.75;
    }
    .ann-content strong {
        font-weight: 700;
    }
    .ann-ask-row {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }
    .ann-ask-row .ts-form-group {
        flex: 1;
        margin-bottom: 0;
    }
    .ann-ask-btn {
        flex-shrink: 0;
        white-space: nowrap;
        width: auto !important;
        margin-top: 0 !important;
        padding: 12px 22px !important;
        align-self: flex-end;
    }
    .ann-answer-box {
        margin-top: 14px;
        padding: 14px 16px;
        background: #eef2ff;
        border: 1.5px solid #c7d2fe;
        border-radius: 10px;
        display: none;
    }
    .ann-answer-box.visible { display: block; }
    .ann-answer-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6366f1;
        margin-bottom: 8px;
    }
    .ann-answer-question {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #c7d2fe;
    }
    .ann-answer-text {
        font-size: 14px;
        color: #1e293b;
        line-height: 1.8;
        word-break: break-word;
    }
    .ann-answer-text strong {
        font-weight: 700;
    }
    .ann-answer-text ul {
        margin: 8px 0 4px 20px;
        padding: 0;
    }
    .ann-answer-text li {
        margin-bottom: 7px;
        line-height: 1.75;
    }
    .ann-answer-text br {
        display: block;
        margin-top: 8px;
        content: "";
    }
    .ann-answer-loading {
        font-size: 13.5px;
        color: #6366f1;
        font-style: italic;
    }
    .ann-file-input {
        display: block;
        width: 100%;
        font-size: 13px;
        font-family: 'Nunito', sans-serif;
        color: #475569;
        background: #f8fafc;
        border: 1.5px dashed #cbd5e1;
        border-radius: 8px;
        padding: 8px 12px;
        cursor: pointer;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .ann-file-input:hover { border-color: #6366f1; }
    .ann-images {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 6px;
    }
    .ann-image {
        width: 100%;
        max-height: 560px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        display: block;
    }
    .ann-delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #cbd5e1;
        font-size: 16px;
        padding: 2px 4px;
        border-radius: 4px;
        line-height: 1;
        transition: color 0.15s;
    }
    .ann-delete-btn:hover { color: #ef4444; }
    .ann-empty {
        text-align: center;
        color: #94a3b8;
        font-size: 14px;
        padding: 32px 0;
    }

  //- Inject server-side jurisdiction data for the frontend JS to consume
  script.
    window.JURISDICTION_LIMITS = !{JSON.stringify(jurisdictionLimits)};

  .ts-container
    .ts-header
      h1.ts-header__title 🛠️ Manual Tools Suite
      p.ts-header__sub Run individual checks for claims without travel documents.
    .ts-tabs
      button.ts-tab-btn.active(data-tab="cirium") 📡 FlightStats
      button.ts-tab-btn(data-tab="toolkit") 🧰 Claim Toolkit
      button.ts-tab-btn(data-tab="announcements") 📢 Announcements

    //- TAB 1: FLIGHTSTATS
    #cirium.ts-tab-content.active
      .ts-card
        .ts-form-row
          .ts-form-group(style="flex: 1;")
            label.ts-label Flight Number
            input#c-flight.ts-input(type="text" placeholder="e.g. U28412" required)
          .ts-form-group(style="flex: 1;")
            label.ts-label Departure Date
            input#c-date.ts-input(type="date" required)
          button#btn-fetch-cirium.ts-btn-fetch(type="button") Search Flight
        #flightResult.ts-results-row

    //- TAB 2: COMBINED TOOLKIT (Grid Layout)
    #toolkit.ts-tab-content
      .ts-toolkit-grid

        //- TOOL: FLIGHT SEARCH (Full Width)
        .ts-card.ts-grid-full.tk-collapsed
          .tk-header
            h2.tk-title 🔎 Flight Search
            span.tk-chevron ▼
          .ts-form-row
            .ts-form-group(style="flex: 1;")
              label.ts-label Flight Number
              input#fs-flight.ts-input(type="text" placeholder="e.g. VY7835 or VY 7835")
            .ts-form-group(style="flex: 1;")
              label.ts-label Flight Date
              input#fs-date.ts-input(type="date")
          .ts-form-row(style="gap: 16px; align-items: center; flex-wrap: wrap;")
            label(style="display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;color:#334155;cursor:pointer;user-select:none;")
              input#fs-chk-ai(type="checkbox" checked style="accent-color:#6366f1;width:15px;height:15px;cursor:pointer;")
              | AirportInfo
            label(style="display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;color:#334155;cursor:pointer;user-select:none;")
              input#fs-chk-fs(type="checkbox" checked style="accent-color:#6366f1;width:15px;height:15px;cursor:pointer;")
              | FlightStats
            label(style="display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;color:#334155;cursor:pointer;user-select:none;")
              input#fs-chk-ft(type="checkbox" checked style="accent-color:#6366f1;width:15px;height:15px;cursor:pointer;")
              | Flightera
          button#btn-flight-search.ts-btn-action(type="button") 🔎 Search Flights

        //- TOOL: EOC RADAR (Full Width)
        .ts-card.ts-grid-full.tk-collapsed
          .tk-header
            h2.tk-title ⚠️ EOC Radar
            span.tk-chevron ▼
          .ts-form-grid
            .ts-form-group
              label.ts-label Flight Date
              div(style="position: relative; display: flex; align-items: center;")
                input#e-date.ts-input(type="text" placeholder="Select or paste a date..." required style="padding-right: 40px; flex: 1;")
                input#e-date-picker.ts-input(type="date" required style="opacity: 0; position: absolute; right: 0; cursor: pointer; width: 40px; height: 40px; margin: 0;")
                label(for="e-date-picker" style="position: absolute; right: 8px; pointer-events: none; font-size: 18px; user-select: none;") 📅
            .ts-form-group
              label.ts-label (Optional) Origin Airport
              input#e-o-iata.ts-input(type="text" placeholder="e.g. LHR or Heathrow")
            .ts-form-group
              label.ts-label (Optional) Dest Airport
              input#e-d-iata.ts-input(type="text" placeholder="e.g. BER or Berlin")
            .ts-form-group
              label.ts-label (Optional) Origin Country
              input#e-o-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
