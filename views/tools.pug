extends layout

block content
  style.
    @keyframes pulsyGlassyRed {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5), inset 0 0 10px rgba(220, 38, 38, 0.1);
            background-color: rgba(254, 242, 242, 0.4);
            border-color: rgba(239, 68, 68, 0.5);
        }
        100% {
            box-shadow: 0 0 20px 8px rgba(220, 38, 38, 0), inset 0 0 30px rgba(220, 38, 38, 0.2);
            background-color: rgba(254, 242, 242, 0.85);
            border-color: rgba(220, 38, 38, 1);
        }
    }
    .eoc-alert-active {
        animation: pulsyGlassyRed 1.5s infinite alternate ease-in-out !important;
        border-width: 2px !important;
        backdrop-filter: blur(8px) !important;
        transition: all 0.3s ease;
    }

    /* Make tabs horizontally scrollable */
    .ts-tabs {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 12px;
        -webkit-overflow-scrolling: touch; 
        scrollbar-width: none;
    }
    .ts-tabs::-webkit-scrollbar {
        display: none;
    }
    .ts-tab-btn {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    /* THE NEW BENTO BOX GRID */
    .ts-toolkit-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
    }
    .ts-card {
        margin-bottom: 0 !important;
        height: 100%;
    }
    .ts-grid-full {
        grid-column: 1 / -1;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
        .ts-toolkit-grid {
            grid-template-columns: 1fr;
        }
    }

  //- Inject server-side jurisdiction data for the frontend JS to consume
  script.
    window.JURISDICTION_LIMITS = !{JSON.stringify(jurisdictionLimits)};

  .ts-container
    .ts-header
      h1.ts-header__title 🛠️ Manual Tools Suite
      p.ts-header__sub Run individual checks for claims without travel documents.
    .ts-tabs
      button.ts-tab-btn.active(data-tab="cirium") 📡 FlightStats
      button.ts-tab-btn(data-tab="toolkit") 🧰 Claim Toolkit

    //- TAB 1: FLIGHTSTATS
    #cirium.ts-tab-content.active
      .ts-card
        .ts-form-row
          .ts-form-group(style="flex: 1;")
            label.ts-label Flight Number
            input#c-flight.ts-input(type="text" placeholder="e.g. U28412" required)
          .ts-form-group(style="flex: 1;")
            label.ts-label Departure Date
            input#c-date.ts-input(type="date" required)
          button#btn-fetch-cirium.ts-btn-fetch(type="button") Search Flight
        #flightResult.ts-results-row

    //- TAB 2: COMBINED TOOLKIT (Grid Layout)
    #toolkit.ts-tab-content
      .ts-toolkit-grid
        
        //- TOOL: EOC RADAR (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") ⚠️ EOC Radar
          .ts-form-grid
            .ts-form-group
              label.ts-label Flight Date
              div(style="position: relative; display: flex; align-items: center;")
                input#e-date.ts-input(type="text" placeholder="Select a date..." required style="padding-right: 40px; flex: 1;")
                input#e-date-picker.ts-input(type="date" required style="opacity: 0; position: absolute; right: 0; cursor: pointer; width: 40px; height: 40px; margin: 0;")
                label(for="e-date-picker" style="position: absolute; right: 8px; pointer-events: none; font-size: 18px; user-select: none;") 📅
            .ts-form-group
              label.ts-label (Optional) Origin Airport
              input#e-o-iata.ts-input(type="text" placeholder="e.g. LHR or Heathrow")
            .ts-form-group
              label.ts-label (Optional) Dest Airport
              input#e-d-iata.ts-input(type="text" placeholder="e.g. BER or Berlin")
            .ts-form-group
              label.ts-label (Optional) Origin Country
              input#e-o-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
            .ts-form-group
              label.ts-label (Optional) Dest Country
              input#e-d-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
          .ts-form-row(style="gap: 12px; margin-top: 0;")
            button#btn-eoc.ts-btn-action ⚠️ Scan EOC Database
            button#btn-sync-eoc.ts-btn-action(style="background: #0f172a; border-color: #0f172a; font-size: 13px;") 🔄 Sync EOC Database
          #syncEocResult
          #eocResult

        //- TOOL: DOCUMENT CHECKER (Half Width)
        .ts-card
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 📄 Document Check
          .ts-form-group
            label.ts-label Search Airline
            input#d-airline.ts-input(type="text" placeholder="Start typing an airline name..." required autocomplete="off")
          #docsResult.ts-results-row(style="margin-top: 24px;")

        //- TOOL: JURISDICTION CHECKER (Half Width)
        .ts-card
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 🏛️ Jurisdiction Checker
          .ts-form-group
            label.ts-label Search Country
            input#j-country.ts-input(type="text" placeholder="Start typing a country... (e.g. Germany)" autocomplete="off")
          #jurisdictionResult.ts-results-row(style="margin-top: 24px;")

        //- TOOL: SMART EMAIL BUILDER (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") ✉️ Multilingual Request Builder
          
          form#emailBuilderForm
            div(style="background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 20px;")
              label(style="display: block; font-size: 13px; font-weight: 800; color: #334155; margin-bottom: 10px;") Select Required Information:
              #emChecklist(style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;")
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Boarding pass")
                  | Boarding Pass
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Ticket number")
                  | Ticket Number (13-digit)
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="PNR / Booking Reference")
                  | PNR / Booking Reference
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="ID / Passport")
                  | ID / Passport
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Signed Power of Attorney")
                  | Signed Power of Attorney
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Booking confirmation")
                  | Booking Confirmation
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Proof of delay")
                  | Proof of Delay
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer;")
                  input(type="checkbox" value="Proof of cancellation")
                  | Proof of Cancellation

                //- Rejection Templates
                div(style="grid-column: 1 / -1; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #cbd5e1;")
                  label(style="display: block; font-size: 12px; font-weight: 800; color: #991b1b; margin-bottom: 6px;") ❌ Rejection Templates (Overrides Doc Requests)
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer; grid-column: 1 / -1;")
                  input(type="checkbox" value="Visa/Documentation Rejection")
                  | Visa or Documentation Issue
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer; grid-column: 1 / -1;")
                  input(type="checkbox" value="Short Delay / No Missed Connection Rejection")
                  | Short Delay / Didn't Miss Connection
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer; grid-column: 1 / -1;")
                  input(type="checkbox" value="No Disruption Found Rejection")
                  | No Disruption Found
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer; grid-column: 1 / -1;")
                  input(type="checkbox" value="Jurisdiction expired Rejection")
                  | Jurisdiction Expired
                label(style="font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px; cursor: pointer; grid-column: 1 / -1;")
                  input(type="checkbox" value="disrupted and affected flights not under same booking Rejection")
                  | Disrupted & Affected Flights Not Under Same Booking

              div(style="margin-top: 10px;")
                input#emCustom.ts-input(type="text" placeholder="Custom request... (e.g. Provide new bank details)" style="border: 1px dashed #cbd5e1;")

            .ts-form-grid(style="align-items: flex-end;")
              .ts-form-group(style="margin-bottom: 0;")
                label.ts-label Output Language
                select#emLanguage.ts-input
                  option(value="English") English
                  option(value="Spanish") Spanish
                  option(value="French") French
                  option(value="German") German
                  option(value="Italian") Italian
                  option(value="Dutch") Dutch
                  option(value="Swedish") Swedish
                  option(value="Polish") Polish
                  option(value="Portuguese") Portuguese
                  option(value="Danish") Danish
                  option(value="Norwegian") Norwegian
                  option(value="Finnish") Finnish
                  option(value="Romanian") Romanian
                  option(value="Czech") Czech
                  option(value="Hungarian") Hungarian
                  option(value="Greek") Greek
                  option(value="Turkish") Turkish
                  option(value="Arabic") Arabic
              button#emGenerateBtn.ts-btn-action(type="submit" style="margin-top: 0;") Generate Content

          #emResultBox(style="display: none; margin-top: 25px; border-top: 1px solid #e2e8f0; padding-top: 20px;")
            div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;")
              span(style="font-size: 13px; font-weight: 700; color: #10b981;") ✅ Content Generated
              button#emCopyBtn(type="button" style="background: #f1f5f9; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; font-weight: 600; color: #334155;") 📋 Copy to Clipboard
            textarea#emOutputText(readonly style="width: 100%; height: 250px; padding: 15px; border: 1px solid #e2e8f0; border-radius: 8px; font-family: monospace; font-size: 13px; line-height: 1.5; resize: vertical; background: #f8fafc; color: #1e293b; box-sizing: border-box;")
            #emEnglishBox(style="display: none; margin-top: 15px;")
              label(style="display: block; font-size: 12px; font-weight: 800; color: #64748b; margin-bottom: 8px; text-transform: uppercase;") English Translation (For Verification)
              #emEnglishText(style="width: 100%; padding: 15px; border: 1px dashed #cbd5e1; border-radius: 8px; font-family: monospace; font-size: 12px; line-height: 1.5; background: #f1f5f9; color: #475569; box-sizing: border-box; white-space: pre-wrap;")

        //- TOOL: COMPENSATION CALCULATOR (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 💸 EC261 Comp Calculator
          .ts-route
            .ts-route__node
              .ts-form-grid(style="margin-bottom: 0;")
                .ts-form-group
                  label.ts-label Origin Airport
                  input#l-origin.ts-input(type="text" placeholder="Start typing... e.g. LHR or Heathrow" required)
                .ts-form-group
                  label.ts-label Origin Country
                  input#l-origin-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
            .ts-route__node
              .ts-form-grid(style="margin-bottom: 0;")
                .ts-form-group
                  label.ts-label Final Destination Airport
                  input#l-dest.ts-input(type="text" placeholder="Start typing... e.g. JFK or Kennedy" required)
                .ts-form-group
                  label.ts-label Destination Country
                  input#l-dest-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
          button#btn-ec261.ts-btn-action 💸 Calculate Compensation
          #ec261Result

  script(src="/js/tools.js")
