extends layout

block content
  style.
    @keyframes pulsyGlassyRed {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5), inset 0 0 10px rgba(220, 38, 38, 0.1);
            background-color: rgba(254, 242, 242, 0.4);
            border-color: rgba(239, 68, 68, 0.5);
        }
        100% {
            box-shadow: 0 0 20px 8px rgba(220, 38, 38, 0), inset 0 0 30px rgba(220, 38, 38, 0.2);
            background-color: rgba(254, 242, 242, 0.85);
            border-color: rgba(220, 38, 38, 1);
        }
    }
    .eoc-alert-active {
        animation: pulsyGlassyRed 1.5s infinite alternate ease-in-out !important;
        border-width: 2px !important;
        backdrop-filter: blur(8px) !important;
        transition: all 0.3s ease;
    }

    /* Make tabs horizontally scrollable */
    .ts-tabs {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 12px;
        -webkit-overflow-scrolling: touch; 
        scrollbar-width: none;
    }
    .ts-tabs::-webkit-scrollbar {
        display: none;
    }
    .ts-tab-btn {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    /* Tab content visibility */
    .ts-tab-content {
        display: none !important;
    }
    .ts-tab-content.active {
        display: block !important;
    }

    /* THE NEW BENTO BOX GRID */
    .ts-toolkit-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        align-items: start;
    }
    .ts-card {
        margin-bottom: 0 !important;
        height: 100%;
    }
    .ts-grid-full {
        grid-column: 1 / -1;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
        .ts-toolkit-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Email Builder */
    .em-section {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
    }
    .em-section-title {
        font-size: 12px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 12px 0;
    }
    .em-checklist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        transition: opacity 0.2s ease;
    }
    .em-checklist-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
        font-size: 13.5px;
        color: #334155;
        line-height: 1.3;
        user-select: none;
    }
    .em-checklist-item:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
    }
    .em-checklist-item input[type="checkbox"] {
        margin-top: 2px;
        flex-shrink: 0;
        accent-color: #6366f1;
        width: 15px;
        height: 15px;
        cursor: pointer;
    }
    .em-rejection-divider {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 8px 0 4px;
    }
    .em-rejection-divider span {
        font-size: 11px;
        font-weight: 800;
        color: #991b1b;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .em-rejection-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #fecaca;
    }
    .em-checklist-item.rejection {
        grid-column: 1 / -1;
        color: #7f1d1d;
    }
    .em-checklist-item.rejection:hover {
        background: #fef2f2;
        border-color: #fecaca;
    }
    .em-checklist-item.rejection input[type="checkbox"] {
        accent-color: #dc2626;
    }
    .em-custom-area {
        margin-top: 12px;
    }
    .em-freestyle-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        padding: 7px 10px;
        border-radius: 7px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }
    .em-freestyle-toggle:has(input:checked) {
        background: #eff6ff;
        border-color: #bfdbfe;
    }
    .em-freestyle-toggle input[type="checkbox"] {
        accent-color: #3b82f6;
        width: 15px;
        height: 15px;
        cursor: pointer;
        flex-shrink: 0;
    }
    .em-freestyle-toggle label {
        font-size: 13px;
        color: #475569;
        cursor: pointer;
        line-height: 1.3;
    }
    .em-freestyle-toggle:has(input:checked) label {
        color: #1d4ed8;
        font-weight: 600;
    }
    .em-bottom-row {
        display: flex;
        gap: 12px;
        align-items: stretch;
    }
    .em-language-group {
        flex: 1;
    }
    .em-language-group label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .em-generate-btn {
        flex-shrink: 0;
        align-self: flex-end;
        background: #6366f1;
        color: #fff;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
        white-space: nowrap;
    }
    .em-generate-btn:hover:not(:disabled) {
        background: #4f46e5;
    }
    .em-generate-btn:active:not(:disabled) {
        transform: scale(0.98);
    }
    .em-generate-btn:disabled {
        background: #a5b4fc;
        cursor: not-allowed;
    }
    .em-result-box {
        margin-top: 20px;
        border-top: 1px solid #e2e8f0;
        padding-top: 20px;
    }
    .em-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .em-result-label {
        font-size: 13px;
        font-weight: 700;
        color: #10b981;
    }
    .em-copy-btn {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        font-weight: 600;
        color: #334155;
        transition: background 0.15s;
    }
    .em-copy-btn:hover {
        background: #e2e8f0;
    }
    .em-output-textarea {
        width: 100%;
        height: 260px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-family: monospace;
        font-size: 13px;
        line-height: 1.6;
        resize: vertical;
        background: #fff;
        color: #1e293b;
        box-sizing: border-box;
        outline: none;
    }
    .em-char-count {
        margin-top: 5px;
        font-size: 11.5px;
        color: #94a3b8;
        text-align: right;
    }
    .em-english-box {
        margin-top: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
    }
    .em-english-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 14px;
        background: #f8fafc;
        border-bottom: 1px dashed #cbd5e1;
    }
    .em-english-label {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .em-english-content {
        padding: 14px;
        font-family: monospace;
        font-size: 12.5px;
        line-height: 1.6;
        background: #f8fafc;
        color: #475569;
        white-space: pre-wrap;
    }
    @media (max-width: 768px) {
        .em-checklist { grid-template-columns: 1fr; }
        .em-bottom-row { flex-direction: column; }
    }

  //- Inject server-side jurisdiction data for the frontend JS to consume
  script.
    window.JURISDICTION_LIMITS = !{JSON.stringify(jurisdictionLimits)};

  .ts-container
    .ts-header
      h1.ts-header__title 🛠️ Manual Tools Suite
      p.ts-header__sub Run individual checks for claims without travel documents.
    .ts-tabs
      button.ts-tab-btn.active(data-tab="cirium") 📡 FlightStats
      button.ts-tab-btn(data-tab="toolkit") 🧰 Claim Toolkit

    //- TAB 1: FLIGHTSTATS
    #cirium.ts-tab-content.active
      .ts-card
        .ts-form-row
          .ts-form-group(style="flex: 1;")
            label.ts-label Flight Number
            input#c-flight.ts-input(type="text" placeholder="e.g. U28412" required)
          .ts-form-group(style="flex: 1;")
            label.ts-label Departure Date
            input#c-date.ts-input(type="date" required)
          button#btn-fetch-cirium.ts-btn-fetch(type="button") Search Flight
        #flightResult.ts-results-row

    //- TAB 2: COMBINED TOOLKIT (Grid Layout)
    #toolkit.ts-tab-content
      .ts-toolkit-grid
        
        //- TOOL: EOC RADAR (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") ⚠️ EOC Radar
          .ts-form-grid
            .ts-form-group
              label.ts-label Flight Date
              div(style="position: relative; display: flex; align-items: center;")
                input#e-date.ts-input(type="text" placeholder="Select or paste a date..." required style="padding-right: 40px; flex: 1;")
                input#e-date-picker.ts-input(type="date" required style="opacity: 0; position: absolute; right: 0; cursor: pointer; width: 40px; height: 40px; margin: 0;")
                label(for="e-date-picker" style="position: absolute; right: 8px; pointer-events: none; font-size: 18px; user-select: none;") 📅
            .ts-form-group
              label.ts-label (Optional) Origin Airport
              input#e-o-iata.ts-input(type="text" placeholder="e.g. LHR or Heathrow")
            .ts-form-group
              label.ts-label (Optional) Dest Airport
              input#e-d-iata.ts-input(type="text" placeholder="e.g. BER or Berlin")
            .ts-form-group
              label.ts-label (Optional) Origin Country
              input#e-o-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
            .ts-form-group
              label.ts-label (Optional) Dest Country
              input#e-d-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
          .ts-form-row(style="gap: 12px; margin-top: 0;")
            button#btn-eoc.ts-btn-action ⚠️ Scan EOC Database
            button#btn-sync-eoc.ts-btn-action(style="background: #0f172a; border-color: #0f172a; font-size: 13px;") 🔄 Sync EOC Database (only if you get notified that it has been updated)
          #syncEocResult
          #eocResult

        //- TOOL: DOCUMENT CHECKER (Half Width)
        .ts-card
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 📄 Document Check
          .ts-form-group
            label.ts-label Search Airline
            input#d-airline.ts-input(type="text" placeholder="Start typing an airline name..." required autocomplete="off")
          #docsResult.ts-results-row(style="margin-top: 24px;")

        //- TOOL: JURISDICTION CHECKER (Half Width)
        .ts-card
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 🏛️ Jurisdiction Checker
          .ts-form-group
            label.ts-label Search Country
            input#j-country.ts-input(type="text" placeholder="Start typing a country... (e.g. Germany)" autocomplete="off")
          #jurisdictionResult.ts-results-row(style="margin-top: 24px;")

        //- TOOL: IATA LOOKUP (Half Width)
        .ts-card
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") ✈️ IATA Lookup
          .ts-form-group
            label.ts-label Airline Name or IATA Code
            input#iata-lookup-input.ts-input(type="text" placeholder="e.g. AA or American Airlines" autocomplete="off")
          button#btn-iata-lookup.ts-btn-action(type="button" style="margin-top: 12px;") 🔍 Search
          #iata-lookup-result(style="margin-top: 16px;")

        //- TOOL: SMART EMAIL BUILDER (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") ✉️ Multilingual Request Builder

          form#emailBuilderForm

            //- TEXT INPUT FOR REQUEST
            .em-section
              p.em-section-title Draft a Template
              textarea#emRequestText.ts-input(type="text" placeholder="e.g., use template ticket number, boarding pass, passengers documents with link: https://example.com/upload, reject visa issue" style="border: 1px solid #e2e8f0; min-height: 80px; resize: vertical;")
              p(style="font-size: 12px; color: #64748b; margin-top: 8px;") Describe the documents or information needed. Use keywords like 'use template', 'ticket number', 'boarding pass', 'reject visa'. Include links where needed.

            //- LANGUAGE + GENERATE
            .em-bottom-row
              .em-language-group
                label(for="emLanguage") Output Language
                select#emLanguage.ts-input
                  option(value="English") English
                  option(value="Spanish") Spanish
                  option(value="French") French
                  option(value="German") German
                  option(value="Italian") Italian
                  option(value="Dutch") Dutch
                  option(value="Swedish") Swedish
                  option(value="Polish") Polish
                  option(value="Portuguese") Portuguese
                  option(value="Danish") Danish
                  option(value="Norwegian") Norwegian
                  option(value="Finnish") Finnish
                  option(value="Romanian") Romanian
                  option(value="Czech") Czech
                  option(value="Hungarian") Hungarian
                  option(value="Greek") Greek
                  option(value="Turkish") Turkish
                  option(value="Arabic") Arabic
              button#emGenerateBtn.em-generate-btn(type="submit") ✨ Generate

          //- RESULT BOX
          #emResultBox.em-result-box(style="display: none;")
            .em-result-header
              span.em-result-label ✅ Content Generated
              button#emCopyBtn.em-copy-btn(type="button") 📋 Copy
            textarea#emOutputText.em-output-textarea(readonly)
            div#emCharCount.em-char-count
            #emEnglishBox(style="display: none;")
              .em-english-box
                .em-english-header
                  span.em-english-label English (Verification)
                  button#emCopyEnglishBtn.em-copy-btn(type="button") 📋 Copy English
                div#emEnglishText.em-english-content

        //- TOOL: COMPENSATION CALCULATOR (Full Width)
        .ts-card.ts-grid-full
          h2(style="color: #1e293b; margin-top: 0; margin-bottom: 20px; font-size: 18px;") 💸 EC261 Comp Calculator
          .ts-route
            .ts-route__node
              .ts-form-grid(style="margin-bottom: 0;")
                .ts-form-group
                  label.ts-label Origin Airport
                  input#l-origin.ts-input(type="text" placeholder="Start typing... e.g. LHR or Heathrow" required)
                .ts-form-group
                  label.ts-label Origin Country
                  input#l-origin-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
            .ts-route__node
              .ts-form-grid(style="margin-bottom: 0;")
                .ts-form-group
                  label.ts-label Final Destination Airport
                  input#l-dest.ts-input(type="text" placeholder="Start typing... e.g. JFK or Kennedy" required)
                .ts-form-group
                  label.ts-label Destination Country
                  input#l-dest-country.ts-input(type="text" placeholder="Auto-filled" readonly tabindex="-1")
          button#btn-ec261.ts-btn-action 💸 Calculate Compensation
          #ec261Result

  script(src="/js/tools.js")
