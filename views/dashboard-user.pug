extends layout-app

block sidebar-nav
  .sidebar__section
    p.sidebar__label Navigation
    a.sidebar__link(href="/") Workspace
    a.sidebar__link.sidebar__link--active(href="/me") My Usage
    if user && user.role === 'admin'
      a.sidebar__link(href="/admin") Admin Panel

block app-content
  - function cc(v) { return (!v || v <= 0) ? '0.00' : (Math.ceil(v * 100) / 100).toFixed(2); }
  - function fmtCost(v) { return (+(v) || 0).toFixed(4); }
  .app-main__header
    h1.app-main__title My Usage
    p.app-main__subtitle Track your operations and API costs

  .ud-month-picker
    label(for="monthSelect") Period:
    select#monthSelect
      each opt in monthOptions
        option(value=`${opt.year}-${opt.month}`, selected=opt.selected)= opt.label
    .ud-month-summary
      span.ud-month-stat= totalOps + ' ops'
      span.ud-month-stat-sep ·
      span.ud-month-stat= '$' + cc(totalCostUSD)

  .stat-grid
    .stat-card
      p.stat-card__label Ops Today
      p.stat-card__value#ud-daily-ops= dailyOps
    .stat-card
      p.stat-card__label Cost Today (USD)
      p.stat-card__value.stat-card__value--blue
        | $
        span#ud-daily-cost(data-raw=dailyCost)= cc(dailyCost)

  .ud-section
    h2.ud-section__title Operation Log
    if recentLogs.length === 0
      p(style="color: var(--text-muted); font-size: 0.875rem;") No operations recorded this period.
    else
      table.ud-table
        thead
          tr
            th Date & Time
            th Operation
            th Model
            th Cost (USD)
            th Details
        tbody
          each log in recentLogs
            tr
              td= new Date(log.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
              td
                span.op-pill(data-type=log.operationType)= log.label
              td(style="color: var(--text-muted); font-size: 0.8125rem;")= log.model || '—'
              td= `$${cc(log.costUSD)}`
              td(style="font-size: 0.8125rem; color: var(--text-muted);")
                if log.metadata && log.metadata.pnr
                  | PNR: #{log.metadata.pnr}
                  if log.metadata.passengerCount
                    |  (#{log.metadata.passengerCount} pax)
                else if log.metadata && log.metadata.language
                  | #{log.metadata.language}
                else if log.metadata && log.metadata.fileCount
                  | #{log.metadata.fileCount} file(s)
                else
                  | —

  if recentLogs.length > 0 || totalLogs > 0
    .ud-pagination#ud-pagination
      button.ud-page-btn#ud-prev-page(disabled) ← Prev
      span.ud-page-info#ud-page-info Page 1 of #{totalPages}
      button.ud-page-btn#ud-next-page(disabled=totalPages <= 1) Next →

block scripts
  script.
    var breakdown = !{JSON.stringify(breakdown)};
    var monthOptions = !{JSON.stringify(monthOptions)};
    var UD_TOTAL_PAGES = !{totalPages};
    var UD_TOTAL_LOGS = !{totalLogs};
    var UD_CURRENT_YEAR = !{currentYear};
    var UD_CURRENT_MONTH = !{currentMonth};
  script(src="/js/user-dashboard.js")
