doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Refly Workspace'
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", type="image/png", href="/images/image-removebg-preview.png")
    script(src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js")
    script(src="/socket.io/socket.io.js")
    block head
  body
    a.skip-link(href="#app-main-content") Skip to main content
    .app-layout
      aside.sidebar
        .sidebar__logo
          a(href="/")
            img(src="/images/image-removebg-preview.png", alt="Refly Logo")
        block sidebar-nav
        .sidebar__spacer
        .sidebar__section
          a.sidebar__link.sidebar__link--danger(href="/logout") Sign Out
      main#app-main-content.app-main
        block app-content
  //- Presence connection: establishes a Socket.io connection for every
  //- authenticated user so the admin panel's online count is accurate.
  //- admin-dashboard.js reuses this same connection (Socket.io client multiplexes).
  script.
    if (typeof io !== 'undefined') { window._presenceSocket = io(); }
  block scripts
