doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Refly Workspace'
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", type="image/png", href="/images/image-removebg-preview.png")
    script(src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js")
    block head
  body
    a.skip-link(href="#app-main-content") Skip to main content
    .app-layout
      aside.sidebar
        .sidebar__logo
          a(href="/")
            img(src="/images/image-removebg-preview.png", alt="Refly Logo")
        block sidebar-nav
        .sidebar__spacer
        .sidebar__section
          a.sidebar__link.sidebar__link--danger(href="/logout") Sign Out
      main#app-main-content.app-main
        block app-content
  script.
    (function () {
      var knownVersion = null;
      var reloading = false;

      function showUpdateBanner(msg) {
        if (reloading) return;
        reloading = true;
        var b = document.createElement('div');
        b.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;padding:14px;text-align:center;font-weight:600;color:#fff;background:#2563eb;font-size:15px;';
        b.textContent = msg;
        document.body.appendChild(b);
        setTimeout(function () { location.reload(); }, 2500);
      }

      // Poll /api/version to detect deploys — works even if SSE is broken
      function checkVersion() {
        fetch('/api/version').then(function (r) { return r.json(); }).then(function (d) {
          if (!knownVersion) { knownVersion = d.version; return; }
          if (d.version !== knownVersion) showUpdateBanner('A new version has been deployed. Reloading...');
        }).catch(function () {});
      }
      checkVersion();
      setInterval(checkVersion, 15000);

      // SSE for instant admin-triggered reloads
      var es = new EventSource('/api/sse/events');
      es.onmessage = function (e) {
        if (e.data === 'reload') showUpdateBanner('An update has occurred. Reloading...');
      };
    })();
  block scripts
