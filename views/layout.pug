doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Workspace Dashboard'
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", type="image/png", href="/images/image-removebg-preview.png")
  body
    //- A11Y [CRITICAL]: Skip to content link for keyboard-only navigation
    a.skip-link(href="#main-content") Skip to main content

    if user
      .app-layout.sidebar-collapsed.no-transition#appLayout
        aside.sidebar
          .sidebar__logo#sidebarToggle(title="Collapse sidebar")
            img(src="/images/image-removebg-preview.png", alt="Refly Logo")
          .sidebar__section
            p.sidebar__label Workspace
            a.sidebar__link(href="/") Dashboard
            a.sidebar__link(href="/me") My Usage
          if user.role === 'admin'
            .sidebar__section
              p.sidebar__label Administration
              a.sidebar__link(href="/admin") Admin Panel
          .sidebar__spacer
          .sidebar__section
            a.sidebar__link.sidebar__link--danger(href="/logout") Sign Out
        main#main-content.app-main
          block content
      button.sidebar-expand-btn#sidebarExpand(title="Expand sidebar")
        img(src="/images/image-removebg-preview.png", alt="Refly Logo")
    else
      main#main-content
        block content
    script.
      (function () {
        var layout = document.getElementById('appLayout');
        var toggle = document.getElementById('sidebarToggle');
        var expand = document.getElementById('sidebarExpand');
        if (layout && toggle) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              layout.classList.remove('no-transition');
            });
          });
          toggle.addEventListener('click', function (e) {
            e.preventDefault();
            layout.classList.add('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', '1');
          });
        }
        if (layout && expand) {
          expand.addEventListener('click', function () {
            layout.classList.remove('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', '0');
          });
        }
      })();
    script.
      (function () {
        var knownVersion = null;
        var pendingVersion = null;
        var confirmCount = 0;
        var reloading = false;

        function showUpdateBanner(msg) {
          if (reloading) return;
          reloading = true;

          var overlay = document.createElement('div');
          overlay.style.cssText = 'position:fixed;inset:0;z-index:99998;background:rgba(0,0,0,0);transition:background .4s ease;';
          document.body.appendChild(overlay);
          requestAnimationFrame(function () { overlay.style.background = 'rgba(0,0,0,.35)'; });

          var toast = document.createElement('div');
          toast.innerHTML = '<div style="display:flex;align-items:center;gap:12px;">'
            + '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;animation:ub-spin 1.2s linear infinite"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>'
            + '<div><div style="font-weight:600;font-size:15px;">' + msg + '</div>'
            + '<div style="font-size:12px;opacity:.75;margin-top:3px;">This page will refresh automatically</div></div></div>'
            + '<div style="position:absolute;bottom:0;left:0;height:3px;background:rgba(255,255,255,.5);border-radius:0 0 14px 14px;animation:ub-bar 3s linear forwards;"></div>';
          toast.style.cssText = 'position:fixed;top:24px;left:50%;z-index:99999;padding:16px 24px;border-radius:14px;color:#fff;font-family:system-ui,sans-serif;'
            + 'background:linear-gradient(135deg,#1e40af,#2563eb);box-shadow:0 8px 32px rgba(0,0,0,.25);'
            + 'transform:translateX(-50%) translateY(-120px);opacity:0;transition:transform .5s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;overflow:hidden;';

          var style = document.createElement('style');
          style.textContent = '@keyframes ub-spin{to{transform:rotate(360deg)}}@keyframes ub-bar{from{width:100%}to{width:0%}}';
          document.head.appendChild(style);
          document.body.appendChild(toast);

          requestAnimationFrame(function () {
            toast.style.transform = 'translateX(-50%) translateY(0)';
            toast.style.opacity = '1';
          });

          setTimeout(function () {
            toast.style.transform = 'translateX(-50%) translateY(-120px)';
            toast.style.opacity = '0';
            setTimeout(function () { location.reload(); }, 500);
          }, 3000);
        }

        // Poll /api/version — require 3 consecutive hits of the new version
        // before reloading, so the rollout is fully stable across all instances
        function checkVersion() {
          fetch('/api/version').then(function (r) { return r.json(); }).then(function (d) {
            if (!knownVersion) { knownVersion = d.version; return; }
            if (d.version === knownVersion) { pendingVersion = null; confirmCount = 0; return; }
            if (d.version === pendingVersion) {
              confirmCount++;
              if (confirmCount >= 3) showUpdateBanner('A new version has been deployed. Reloading...');
            } else {
              pendingVersion = d.version;
              confirmCount = 1;
            }
          }).catch(function () {});
        }
        checkVersion();
        setInterval(checkVersion, 5000);

        // SSE for instant admin-triggered reloads
        if (#{user ? 'true' : 'false'}) {
          var es = new EventSource('/api/sse/events');
          es.onmessage = function (e) {
            if (e.data === 'reload') showUpdateBanner('An update has occurred. Reloading...');
          };
        }
      })();
    block scripts