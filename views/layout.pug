doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Workspace Dashboard'
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", type="image/png", href="/images/image-removebg-preview.png")
  body
    //- A11Y [CRITICAL]: Skip to content link for keyboard-only navigation
    a.skip-link(href="#main-content") Skip to main content

    //- A11Y [CRITICAL]: Semantic header and navigation landmark
    header.global-header
      .nav-container(style="display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto;")
        a(href="/", aria-label="Go to Dashboard")
          img(src="/images/Screenshot_1.png", alt="Refly Logo", style="height: 60px;")
        if user
          nav.global-nav
            if user.role === 'admin'
              a.global-nav__link(href="/admin") Admin Panel
            a.global-nav__link(href="/me") My Usage
            a.global-nav__link.global-nav__link--logout(href="/logout") Sign Out
  
    //- A11Y [CRITICAL]: Main landmark so screen readers know where the app logic begins
    main#main-content
      block content
    script.
      (function () {
        var knownVersion = null;
        var reloading = false;

        function showUpdateBanner(msg) {
          if (reloading) return;
          reloading = true;
          var b = document.createElement('div');
          b.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;padding:14px;text-align:center;font-weight:600;color:#fff;background:#2563eb;font-size:15px;';
          b.textContent = msg;
          document.body.appendChild(b);
          setTimeout(function () { location.reload(); }, 2500);
        }

        // Poll /api/version to detect deploys — works even if SSE is broken
        function checkVersion() {
          fetch('/api/version').then(function (r) { return r.json(); }).then(function (d) {
            if (!knownVersion) { knownVersion = d.version; return; }
            if (d.version !== knownVersion) showUpdateBanner('A new version has been deployed. Reloading...');
          }).catch(function () {});
        }
        checkVersion();
        setInterval(checkVersion, 15000);

        // SSE for instant admin-triggered reloads
        if (#{user ? 'true' : 'false'}) {
          var es = new EventSource('/api/sse/events');
          es.onmessage = function (e) {
            if (e.data === 'reload') showUpdateBanner('An update has occurred. Reloading...');
          };
        }
      })();
    block scripts